{
  "name": "nte-flowboard",
  "private": true,
  "version": "2.7.4",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "npm run lint && npm run typecheck && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/ config/ scripts/ package.json tsconfig*.json eslint.config.js .github/workflows/*.yml",
    "format:check": "prettier --check src/ tests/ config/ scripts/ package.json tsconfig*.json eslint.config.js .github/workflows/*.yml",
    "check:dead-code": "knip",
    "check:size": "size-limit",
    "test": "vitest run --config config/vite.config.ts",
    "test:coverage": "vitest run --coverage --config config/vite.config.ts",
    "test:integration:supabase": "vitest run --config config/vitest.integration.config.ts",
    "test:mutation": "stryker run config/stryker.config.json",
    "test:watch": "vitest --config config/vite.config.ts",
    "test:browser": "playwright test --config config/playwright.config.ts",
    "clean": "node scripts/clean.mjs"
  },
  "knip": {
    "entry": [
      "supabase/functions/*/index.ts"
    ],
    "ignoreDependencies": [
      "npm"
    ],
    "ignore": [
      "public/theme-bootstrap.js",
      "public/flowboard-sw.js"
    ]
  },
  "overrides": {
    "qs": "6.15.3"
  },
  "size-limit": [
    {
      "name": "JavaScript (gzip)",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "275 kB"
    },
    {
      "name": "CSS (gzip)",
      "path": "dist/assets/*.css",
      "gzip": true,
      "limit": "15 kB"
    },
    {
      "name": "Primary image",
      "path": "dist/assets/*.png",
      "brotli": false,
      "limit": "80 kB"
    }
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@supabase/supabase-js": "^2.107.0",
    "clsx": "2.1.1",
    "colord": "^2.9.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.10",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.30.0",
    "prettier": "^3.8.3",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  }
}
